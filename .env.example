# ─────────────────────────────────────────────────────────────
# AI Twin Configuration
# ─────────────────────────────────────────────────────────────

# Default provider: gemini | groq | demo
# If a key is set for a provider, it auto-activates. Otherwise falls back to Offline demo.
VITE_AI_PROVIDER=gemini

# Google Gemini Free API Key (100% free at https://aistudio.google.com/app/apikey)
# 15 requests/min, 1,500 requests/day — no credit card needed.
VITE_GEMINI_API_KEY=

# Groq Free API Key (100% free at https://console.groq.com/keys)
# Ultra-fast Llama 3.3 inference, generous free tier — no credit card needed.
VITE_GROQ_API_KEY=

# Custom proxy endpoints (optional — keeps keys server-side)
VITE_GEMINI_ENDPOINT=
VITE_GROQ_ENDPOINT=

# ─────────────────────────────────────────────────────────────
# Web3Forms Contact Form (Free at https://web3forms.com)
# ─────────────────────────────────────────────────────────────
VITE_WEB3FORMS_ACCESS_KEY=
