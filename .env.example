# ─────────────────────────────────────────────────────────────
# AI Twin Configuration
# ─────────────────────────────────────────────────────────────

# Default provider for visitors: gemini | claude | deepseek | demo
# If VITE_GEMINI_API_KEY is provided, it automatically connects to Google Gemini!
# If no key is set or user is offline, it seamlessly falls back to the on-device Offline Demo.
VITE_AI_PROVIDER=gemini

# Google Gemini Free Tier API Key (Get 100% free at https://aistudio.google.com/app/apikey)
# Gives 15 requests/min & 1,500 requests/day at zero cost with no credit card required.
VITE_GEMINI_API_KEY=

# Server-side proxies or endpoints (optional)
VITE_GEMINI_ENDPOINT=
VITE_CLAUDE_ENDPOINT=
VITE_DEEPSEEK_ENDPOINT=

# ─────────────────────────────────────────────────────────────
# Web3Forms Contact Form (Free access key at https://web3forms.com)
# ─────────────────────────────────────────────────────────────
VITE_WEB3FORMS_ACCESS_KEY=
