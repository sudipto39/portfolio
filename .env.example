# ─────────────────────────────────────────────────────────────
# AI twin configuration (all optional)
# Copy to `.env` and rebuild. Never put raw API keys here —
# anything prefixed with VITE_ is shipped to the browser.
# ─────────────────────────────────────────────────────────────

# Default provider for visitors: claude | deepseek | demo
VITE_AI_PROVIDER=demo

# Server-side proxies that inject your API keys (see the proxy snippet
# in the "AI twin" section FAQ). The client calls:
#   ${VITE_CLAUDE_ENDPOINT}/v1/messages
#   ${VITE_DEEPSEEK_ENDPOINT}/chat/completions
VITE_CLAUDE_ENDPOINT=
VITE_DEEPSEEK_ENDPOINT=
